                                    </StackPanel>
                                </DockPanel>

                                <WrapPanel>
                                    <ui:Button Content="Tiếng Việt (vi)" Style="{StaticResource SettingsChoicePillStyle}" Command="{Binding SelectTranslateLanguageCommand}" CommandParameter="vi" />
                                    <ui:Button Content="English (en)" Style="{StaticResource SettingsChoicePillStyle}" Command="{Binding SelectTranslateLanguageCommand}" CommandParameter="en" />
                                    <ui:Button Content="日本語 (ja)" Style="{StaticResource SettingsChoicePillStyle}" Command="{Binding SelectTranslateLanguageCommand}" CommandParameter="ja" />
                                    <ui:Button Content="한국어 (ko)" Style="{StaticResource SettingsChoicePillStyle}" Command="{Binding SelectTranslateLanguageCommand}" CommandParameter="ko" />
                                    <ui:Button Content="中文 (zh-CN)" Style="{StaticResource SettingsChoicePillStyle}" Command="{Binding SelectTranslateLanguageCommand}" CommandParameter="zh-CN" />
                                </WrapPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <StackPanel>
                                    <TextBlock Text="Dịch trực tiếp trên trang (In-Place DOM Translation)" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="Giữ nguyên URL, phiên đăng nhập và nội dung đang nhập trong biểu mẫu (kể cả trang nội bộ/intranet). Bạn có thể chuyển nhanh qua lại giữa bản dịch và bản gốc ngay trên thanh nổi góc phải."
                                               Style="{StaticResource SettingsRowSubtitleStyle}" />
                                 </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

