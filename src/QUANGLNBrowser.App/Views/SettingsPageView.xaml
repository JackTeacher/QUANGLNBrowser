                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GxCleanerFreedText}" Style="{StaticResource SettingsRowSubtitleStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Progress Bar & Status -->
                                <ProgressBar Value="{Binding GxCleanerProgress}" Height="4" Margin="0,4,0,6" Foreground="{DynamicResource ThemeAccentBrush}" Background="#1F2937" BorderThickness="0" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GxCleanerProgress, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F9FAFB" />
                                    <TextBlock Text="{Binding GxCleanerStatusText}" FontSize="11" Foreground="#9CA3AF" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================================= -->
                    <!-- SECTION 8: NGÔN NGỮ & DỊCH TRANG                                       -->
                    <!-- ======================================================================= -->
                    <StackPanel Visibility="{Binding ShowSectionLanguage, Converter={StaticResource BoolToVis}}">
