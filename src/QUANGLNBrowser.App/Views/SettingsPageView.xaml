                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#818CF8" Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.09-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.01.06.02.09.01 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Discord" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Kênh thoại và cộng đồng game thủ" Style="{StaticResource SettingsRowSubtitleStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <!-- Telegram -->
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SidebarShowTelegram, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#122638" BorderBrush="#214B6E" BorderThickness="1" Margin="0,0,12,0">
                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,0,0,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#38BDF8" Data="M21.9 4.2c.3-.9-.5-1.7-1.4-1.3L2.8 9.8c-1 .4-.9 1.8.1 2.1l4.4 1.4 1.7 5.3c.2.7 1.1.9 1.6.4l2.5-2.5 4.8 3.5c.8.6 1.9.1 2.1-.8L21.9 4.2zM9.2 13.4l8.3-5.8c.2-.1.4.2.2.3l-6.8 6.4-.3 3.1-1.4-4z" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Telegram" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Kênh tin tức nhanh và lưu trữ đám mây" Style="{StaticResource SettingsRowSubtitleStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <!-- AI Chat -->
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SidebarShowAiChat, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#142922" BorderBrush="#22463A" BorderThickness="1" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Sparkle20" FontSize="17" Foreground="{DynamicResource ThemeAccentBrush}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="AI Chat" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Trợ lý AI tóm tắt trang web và hỗ trợ viết lách" Style="{StaticResource SettingsRowSubtitleStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <!-- Dấu trang (Bookmarks) -->
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SidebarShowBookmarks, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#171E26" BorderBrush="#26313E" BorderThickness="1" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Bookmark20" FontSize="16" Foreground="#E2E8F0" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Dấu trang (Bookmarks)" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Mở nhanh ngăn kéo danh sách trang web yêu thích đã lưu" Style="{StaticResource SettingsRowSubtitleStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <!-- Lịch sử (History) -->
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SidebarShowHistory, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#171E26" BorderBrush="#26313E" BorderThickness="1" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="History20" FontSize="16" Foreground="#E2E8F0" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Lịch sử duyệt web" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Tra cứu lại các trang đã truy cập gần đây từ thanh bên" Style="{StaticResource SettingsRowSubtitleStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <!-- Quản lý tải xuống -->
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SidebarShowDownloads, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#282115" BorderBrush="#443720" BorderThickness="1" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="17" Foreground="#F59E0B" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Quản lý tải xuống" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Theo dõi các luồng tải đa luồng 8x đang chạy" Style="{StaticResource SettingsRowSubtitleStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================================= -->
                    <!-- SECTION 11: TRÌNH DUYỆT MẶC ĐỊNH & GIỚI THIỆU QUANGLN                  -->
                    <!-- ======================================================================= -->
                    <StackPanel Visibility="{Binding ShowSectionDefaultAbout, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Trình duyệt mặc định &amp; Giới thiệu QUANGLN Browser" Style="{StaticResource SettingsSectionHeaderStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Đặt làm mặc định" Appearance="Primary"
                                               Height="34" Padding="14,0" FontSize="12"
                                               Command="{Binding OpenWindowsDefaultAppsCommand}" />
                                    <StackPanel>
                                        <TextBlock Text="Trình duyệt mặc định trên Windows" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Text="Mở cài đặt Ứng dụng mặc định của Windows để đặt QUANGLN Browser làm trình duyệt chính."
                                                   Style="{StaticResource SettingsRowSubtitleStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Khôi phục mặc định" Appearance="Secondary"
                                               Height="34" Padding="14,0" FontSize="12"
                                               Command="{Binding ResetBrowserSettingsCommand}" />
                                    <StackPanel>
                                        <TextBlock Text="Đặt lại toàn bộ cài đặt về mặc định ban đầu" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Text="Khôi phục chủ đề Cốc Cốc Neon, công cụ tìm kiếm Google, trang chủ, thu phóng 100% và thư mục tải về mặc định (không xóa Bookmarks hay mật khẩu Vault)."
                                                   Style="{StaticResource SettingsRowSubtitleStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/logo.png"
                                           Width="56"
                                           Height="56"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,14,0"
                                           VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="QUANGLN Browser · Phiên bản 1.0 (x64)" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB" />
                                        <TextBlock Text="Nền tảng: .NET 8 WPF (WPF-UI v3 Dark Mica) · Nhân duyệt web: CefSharp Chromium x64"
                                                   Style="{StaticResource SettingsRowSubtitleStyle}" Margin="0,4,0,2" />
                                        <TextBlock Text="Bảo mật: SQLCipher AES-256 + Argon2id + Windows Hello + Win32 Job Object Zero-Leak"
                                                   Style="{StaticResource SettingsRowSubtitleStyle}" Margin="0,2,0,2" />
                                        <TextBlock Text="Mạng &amp; Media: sing-box (1.1.1.1 WARP / VLESS / Shadowsocks) · AdBlock 2 tầng · FFmpeg / yt-dlp / libmpv"
                                                   Style="{StaticResource SettingsRowSubtitleStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
