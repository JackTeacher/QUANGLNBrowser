                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <TextBlock Text="Duyệt web ẩn danh tức thì" Style="{StaticResource SettingsRowTitleStyle}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Mở Cửa sổ Ẩn danh mới" Appearance="Secondary" Height="34" Padding="12,0" Margin="0,0,8,0" FontSize="12"
                                               Command="{Binding NewIncognitoWindowCommand}" />
                                    <ui:Button Content="Mở Ẩn danh kèm 1.1.1.1 WARP" Appearance="Secondary" Height="34" Padding="12,0" FontSize="12"
                                               Command="{Binding NewIncognitoWarpWindowCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- CARD TỐI ƯU THÔNG MINH & DỌN DẸP (GX CLEANER & TAB SNOOZER) -->
                        <TextBlock Text="Tối ưu thông minh &amp; Dọn dẹp" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0,16,0,0" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- Row 1: Tab Snoozer -->
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox SelectedIndex="{Binding TabSnoozeTimeoutIndex, Mode=TwoWay}" Width="130" Height="34" Margin="0,0,10,0"
                                                  Foreground="#F9FAFB" Background="#111827" BorderBrush="#374151">
                                            <ComboBoxItem Content="Sau 15 phút" />
                                            <ComboBoxItem Content="Sau 30 phút" />
                                            <ComboBoxItem Content="Sau 1 giờ" />
                                            <ComboBoxItem Content="Sau 2 giờ" />
                                            <ComboBoxItem Content="Sau 4 giờ" />
                                        </ComboBox>
                                        <ui:ToggleSwitch IsChecked="{Binding IsTabSnoozerEnabled, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Chế độ Ngủ Tab tự động (Tab Snoozer)" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Text="Tự động đưa các tab không tương tác về trạng thái ngủ để giải phóng RAM." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <!-- Row 2: Hardware Acceleration -->
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsHardwareAccelerationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Tăng tốc phần cứng (Hardware Acceleration)" Style="{StaticResource SettingsRowTitleStyle}" />
                                        <TextBlock Text="Sử dụng GPU để dựng hình mượt mà cho video 4K, đồ họa WebGL và cuộn trang 120Hz+." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <!-- Row 3: GX Cleaner -->
                                <DockPanel Margin="0,0,0,10">
