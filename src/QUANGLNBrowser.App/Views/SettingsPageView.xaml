                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="GX Cleaner — Dọn bộ nhớ đệm &amp; dữ liệu rác" Style="{StaticResource SettingsRowTitleStyle}" Margin="0,0,8,0" />
                                            <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource ThemeAccentSoftBrush}" BorderBrush="{DynamicResource ThemeAccentBorderBrush}" BorderThickness="1">
