                                    <ui:Button Content="Mở thư mục tải về" Appearance="Secondary" Height="34" Padding="14,0" FontSize="12"
                                               Command="{Binding OpenDefaultDownloadFolderCommand}" />
                                </StackPanel>

                                <Border Style="{StaticResource SettingsDividerStyle}" />

                                <StackPanel>
                                    <TextBlock Text="Bộ tải đa luồng 8 luồng &amp; Video Sniffer kiểu Cốc Cốc" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="Tự động bắt luồng MP4, HLS (.m3u8), DASH (.mpd), hỗ trợ trích xuất chất lượng cao với yt-dlp / FFmpeg và phát tách cửa sổ bằng libmpv. Mọi tiến trình con được quản lý an toàn qua Win32 Job Object."
                                               Style="{StaticResource SettingsRowSubtitleStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================================= -->
                    <!-- SECTION 10: THANH BÊN (SIDEBAR KIỂU OPERA GX)                           -->
