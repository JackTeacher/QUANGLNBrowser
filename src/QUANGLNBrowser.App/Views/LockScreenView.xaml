<UserControl x:Class="QUANGLNBrowser.App.Views.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:QUANGLNBrowser.App.Converters"
             IsVisibleChanged="OnLockScreenIsVisibleChanged">
    <UserControl.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <!-- Nền đặc 100% che kín hoàn toàn nội dung web và tab phía sau -->
    <Grid Background="{DynamicResource BrowserSurfaceBrush}">
        <!-- Khung Popup 2 cột: Đồng hồ / Âm lịch / Thời tiết (trái) + Mở khóa Vault (phải) -->
        <Border Width="820"
                MinHeight="430"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BrowserChromeBrush}"
                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                BorderThickness="1.2"
                CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="410" />
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: ĐỒNG HỒ SỐ + NGÀY DƯƠNG + ÂM LỊCH + THỜI TIẾT -->
                <Grid Grid.Column="0" Margin="28,28,24,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Đồng hồ + Ngày dương + Pill Âm lịch -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockText}"
                                   FontSize="66"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB"
                                   HorizontalAlignment="Center"
                                   LineHeight="72" />
                        <TextBlock Text="{Binding SolarDateText}"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   Foreground="#E5E7EB"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,10" />
                        <Border CornerRadius="8"
                                Padding="16,5"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ThemeAccentBrush}">
                            <TextBlock Text="{Binding LunarDateText}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#06120B" />
                        </Border>
                    </StackPanel>

                    <!-- Đường phân cách ngang -->
                    <Border Grid.Row="1"
                            Height="1"
                            Margin="16,18"
                            Background="{DynamicResource BrowserBorderBrush}" />

                    <!-- Thời tiết trực tiếp -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <ContentControl Content="{Binding}"
                                            Width="52"
                                            Height="52"
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <!-- Mặc định: Nắng nhẹ (⛅) giống icon trên Trang chủ -->
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Viewbox Stretch="Uniform">
                                                        <Canvas Width="64" Height="64">
                                                            <!-- Mặt trời vàng cam phía sau -->
                                                            <Ellipse Canvas.Left="8" Canvas.Top="10" Width="28" Height="28">
                                                                <Ellipse.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#FDE047" Offset="0" />
                                                                        <GradientStop Color="#F97316" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Path Stroke="#FACC15" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Data="M22,3 L22,7 M8,9 L11,12 M36,9 L33,12 M3,24 L7,24 M8,39 L11,36" />
                                                            <!-- Đám mây trắng mịn phía trước -->
                                                            <Path Data="M19,48 L47,48 C53.075,48 58,43.075 58,37 C58,31.34 53.72,26.68 48.22,26.07 C46.46,19.12 40.16,14 32.65,14 C23.79,14 16.6,21.19 16.6,30.05 C16.6,30.44 16.62,30.82 16.65,31.2 C12.31,32.27 9.1,36.18 9.1,40.85 C9.1,44.8 13.53,48 19,48 Z">
                                                                <Path.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                                                        <GradientStop Color="#CBD5E1" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Path.Fill>
                                                            </Path>
                                                        </Canvas>
                                                    </Viewbox>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Trời quang (☀️) -->
                                            <DataTrigger Binding="{Binding WeatherIconGlyph}" Value="☀️">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Viewbox Stretch="Uniform">
                                                                <Canvas Width="64" Height="64">
                                                                    <Ellipse Canvas.Left="15" Canvas.Top="15" Width="34" Height="34">
                                                                        <Ellipse.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                <GradientStop Color="#FEF08A" Offset="0" />
                                                                                <GradientStop Color="#F97316" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Ellipse.Fill>
                                                                    </Ellipse>
                                                                    <Path Stroke="#FACC15" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          Data="M32,5 L32,11 M32,53 L32,59 M5,32 L11,32 M53,32 L59,32 M12.9,12.9 L17.1,17.1 M46.9,46.9 L51.1,51.1 M51.1,12.9 L46.9,17.1 M17.1,46.9 L12.9,51.1" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Nhiều mây (☁️) -->
                                            <DataTrigger Binding="{Binding WeatherIconGlyph}" Value="☁️">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Viewbox Stretch="Uniform">
                                                                <Canvas Width="64" Height="64">
                                                                    <Path Fill="#94A3B8" Data="M26,40 L50,40 C54.97,40 59,35.97 59,31 C59,26.36 55.49,22.54 50.98,22.05 C49.53,16.37 44.38,12.2 38.25,12.2 C31.02,12.2 25.15,18.07 25.15,25.3 C25.15,25.62 25.17,25.93 25.19,26.24 C21.65,27.11 19.03,30.31 19.03,34.13 C19.03,37.37 22.15,40 26,40 Z" />
                                                                    <Path Data="M16,50 L45,50 C51.075,50 56,45.075 56,39 C56,33.34 51.72,28.68 46.22,28.07 C44.46,21.12 38.16,16 30.65,16 C21.79,16 14.6,23.19 14.6,32.05 C14.6,32.44 14.62,32.82 14.65,33.2 C10.31,34.27 7.1,38.18 7.1,42.85 C7.1,46.8 11.0,50 16,50 Z">
                                                                        <Path.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#F8FAFC" Offset="0" />
                                                                                <GradientStop Color="#CBD5E1" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Path.Fill>
                                                                    </Path>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Mưa rào (🌦️) -->
                                            <DataTrigger Binding="{Binding WeatherIconGlyph}" Value="🌦️">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Viewbox Stretch="Uniform">
                                                                <Canvas Width="64" Height="64">
                                                                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="26" Height="26">
                                                                        <Ellipse.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                <GradientStop Color="#FDE047" Offset="0" />
                                                                                <GradientStop Color="#F97316" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Ellipse.Fill>
                                                                    </Ellipse>
                                                                    <Path Data="M19,44 L47,44 C53.075,44 58,39.075 58,33 C58,27.34 53.72,22.68 48.22,22.07 C46.46,15.12 40.16,10 32.65,10 C23.79,10 16.6,17.19 16.6,26.05 C16.6,26.44 16.62,26.82 16.65,27.2 C12.31,28.27 9.1,32.18 9.1,36.85 C9.1,40.8 13.53,44 19,44 Z">
                                                                        <Path.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#FFFFFF" Offset="0" />
                                                                                <GradientStop Color="#CBD5E1" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Path.Fill>
                                                                    </Path>
                                                                    <Path Stroke="#38BDF8" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          Data="M22,49 L19,57 M33,49 L30,57 M44,49 L41,57" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Có mưa (🌧️) -->
                                            <DataTrigger Binding="{Binding WeatherIconGlyph}" Value="🌧️">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Viewbox Stretch="Uniform">
                                                                <Canvas Width="64" Height="64">
                                                                    <Path Data="M17,42 L47,42 C53.075,42 58,37.075 58,31 C58,25.34 53.72,20.68 48.22,20.07 C46.46,13.12 40.16,8 32.65,8 C23.79,8 16.6,15.19 16.6,24.05 C16.6,24.44 16.62,24.82 16.65,25.2 C12.31,26.27 9.1,30.18 9.1,34.85 C9.1,38.8 12.6,42 17,42 Z">
                                                                        <Path.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#E2E8F0" Offset="0" />
                                                                                <GradientStop Color="#94A3B8" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Path.Fill>
                                                                    </Path>
                                                                    <Path Stroke="#38BDF8" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          Data="M20,48 L17,57 M32,48 L29,57 M44,48 L41,57" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Giông bão (⛈️) -->
                                            <DataTrigger Binding="{Binding WeatherIconGlyph}" Value="⛈️">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Viewbox Stretch="Uniform">
                                                                <Canvas Width="64" Height="64">
                                                                    <Path Data="M17,40 L47,40 C53.075,40 58,35.075 58,29 C58,23.34 53.72,18.68 48.22,18.07 C46.46,11.12 40.16,6 32.65,6 C23.79,6 16.6,13.19 16.6,22.05 C16.6,22.44 16.62,22.82 16.65,23.2 C12.31,24.27 9.1,28.18 9.1,32.85 C9.1,36.8 12.6,40 17,40 Z">
                                                                        <Path.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#CBD5E1" Offset="0" />
                                                                                <GradientStop Color="#64748B" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Path.Fill>
                                                                    </Path>
                                                                    <Path Fill="#FACC15" Data="M33,38 L24,50 L31,50 L28,60 L40,46 L33,46 Z" />
                                                                    <Path Stroke="#38BDF8" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          Data="M18,46 L15,54 M46,46 L43,54" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Sương mù (🌫️) -->
                                            <DataTrigger Binding="{Binding WeatherIconGlyph}" Value="🌫️">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Viewbox Stretch="Uniform">
                                                                <Canvas Width="64" Height="64">
                                                                    <Path Data="M17,36 L47,36 C52.5,36 57,31.5 57,26 C57,20.9 53.1,16.7 48.1,16.1 C46.4,9.8 40.6,5.2 33.7,5.2 C25.5,5.2 18.9,11.8 18.9,20 C18.9,20.4 18.9,20.7 19,21 C15,22 12,25.5 12,29.8 C12,33.4 14.3,36 17,36 Z">
                                                                        <Path.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#F1F5F9" Offset="0" />
                                                                                <GradientStop Color="#94A3B8" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Path.Fill>
                                                                    </Path>
                                                                    <Path Stroke="#CBD5E1" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          Data="M12,43 L52,43 M16,50 L48,50 M22,57 L42,57" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Mưa tuyết (❄️) -->
                                            <DataTrigger Binding="{Binding WeatherIconGlyph}" Value="❄️">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Viewbox Stretch="Uniform">
                                                                <Canvas Width="64" Height="64">
                                                                    <Path Data="M17,41 L47,41 C53.075,41 58,36.075 58,30 C58,24.34 53.72,19.68 48.22,19.07 C46.46,12.12 40.16,7 32.65,7 C23.79,7 16.6,14.19 16.6,23.05 C16.6,23.44 16.62,23.82 16.65,24.2 C12.31,25.27 9.1,29.18 9.1,33.85 C9.1,37.8 12.6,41 17,41 Z">
                                                                        <Path.Fill>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#F8FAFC" Offset="0" />
                                                                                <GradientStop Color="#CBD5E1" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Path.Fill>
                                                                    </Path>
                                                                    <Ellipse Canvas.Left="17" Canvas.Top="48" Width="6" Height="6" Fill="#BAE6FD" />
                                                                    <Ellipse Canvas.Left="29" Canvas.Top="52" Width="6" Height="6" Fill="#E0F2FE" />
                                                                    <Ellipse Canvas.Left="41" Canvas.Top="48" Width="6" Height="6" Fill="#BAE6FD" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <TextBlock Text="{Binding WeatherTempText}"
                                       FontSize="50"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Viewbox Width="14" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource ThemeAccentBrush}"
                                          Data="M12,2 C8.13,2 5,5.13 5,9 C5,14.25 12,22 12,22 C12,22 19,14.25 19,9 C19,5.13 15.87,2 12,2 Z M12,11.5 C10.62,11.5 9.5,10.38 9.5,9 C9.5,7.62 10.62,6.5 12,6.5 C13.38,6.5 14.5,7.62 14.5,9 C14.5,10.38 13.38,11.5 12,11.5 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding WeatherCityText}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F4F6"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding WeatherDetailText}"
                                   FontSize="13"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ĐƯỜNG CHIA DỌC GIỮA 2 CỘT -->
                <Border Grid.Column="1"
                        Margin="0,22"
                        Background="{DynamicResource BrowserBorderBrush}" />

                <!-- CỘT PHẢI: LOGO + FORM MỞ KHÓA VAULT -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="30,28">
                    <!-- Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="80"
                               Height="80"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                        <TextBlock Text="QUANGLN Browser Vault"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#F9FAFB"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Khởi tạo khóa bảo mật AES-256 (Argon2id)"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Nhập PIN hoặc Master Password để mở khóa hồ sơ"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsFirstRun, Converter={StaticResource InvBoolToVis}}" />
                    </StackPanel>

                    <!-- InfoBar lỗi -->
                    <ui:InfoBar Title="Xác thực"
                                Message="{Binding ErrorMessage}"
                                Severity="Error"
                                IsOpen="{Binding HasError}"
                                IsClosable="False"
                                Margin="0,0,0,14"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <!-- Master PIN / Password -->
                    <TextBlock Text="PIN / Master Password"
                               FontSize="12"
                               Foreground="#D1D5DB"
                               Margin="0,0,0,6" />
                    <ui:PasswordBox x:Name="PinBox"
                                    PlaceholderText="Nhập mã PIN hoặc mật khẩu..."
                                    KeyDown="OnPinBoxKeyDown"
                                    Margin="0,0,0,12" />

                    <!-- First-Run Setup Fields -->
                    <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Xác nhận PIN / Master Password"
                                   FontSize="12"
                                   Foreground="#D1D5DB"
                                   Margin="0,0,0,6" />
                        <ui:PasswordBox x:Name="ConfirmPinBox"
                                        PlaceholderText="Nhập lại mật khẩu..."
                                        KeyDown="OnPinBoxKeyDown"
                                        Margin="0,0,0,12" />

                        <TextBlock Text="Decoy PIN (Tùy chọn - mở hồ sơ khách trống)"
                                   FontSize="12"
                                   Foreground="#D1D5DB"
                                   Margin="0,0,0,6" />
                        <ui:PasswordBox x:Name="DecoyPinBox"
                                        PlaceholderText="Để trống nếu không dùng..."
                                        KeyDown="OnPinBoxKeyDown"
                                        Margin="0,0,0,12" />

                        <CheckBox Content="Bật mở khóa nhanh bằng Windows Hello"
                                  IsChecked="{Binding EnableWindowsHello}"
                                  IsEnabled="{Binding IsWindowsHelloAvailable}"
                                  Foreground="#E5E7EB"
                                  Margin="0,0,0,16" />
                    </StackPanel>

                    <!-- Submit Button -->
                    <ui:Button Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Height="40"
                               Click="OnSubmitClicked"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Mở khóa" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirstRun}" Value="True">
                                        <Setter Property="Content" Value="Tạo Vault &amp; Mở khóa" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Windows Hello Unlock -->
                    <ui:Button Content="Mở khóa bằng Windows Hello"
                               Icon="{ui:SymbolIcon Fingerprint24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Margin="0,10,0,0"
                               Command="{Binding UnlockWithWindowsHelloCommand}"
                               Visibility="{Binding CanUseWindowsHelloUnlock, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
