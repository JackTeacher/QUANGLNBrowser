<ui:FluentWindow x:Class="QUANGLNBrowser.App.Views.QrCodeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Tạo mã QR cho trang này"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="360"
                 Height="470"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource BrowserSurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource BrowserChromeBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="Mã QR cho trang này" FontSize="13" FontWeight="SemiBold" Foreground="#F3F4F6" VerticalAlignment="Center" />
            </StackPanel>
            <ui:TitleBar ShowMaximize="False" ShowMinimize="False" ShowClose="True" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,16,20,20" HorizontalAlignment="Stretch">
            <TextBlock Text="Quét mã QR bằng điện thoại để mở nhanh trang này trên thiết bị khác."
                       FontSize="12"
                       Foreground="#9CA3AF"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,14" />

            <Border Background="#FFFFFF"
                    CornerRadius="14"
                    Padding="14"
                    Width="228"
                    Height="228"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                <Image x:Name="QrImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <ui:TextBox x:Name="UrlInputBox"
                        FontSize="12"
                        PlaceholderText="Nhập liên kết để tạo mã QR..."
                        TextChanged="OnUrlTextChanged"
                        Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Content="Sao chép liên kết"
                           Appearance="Secondary"
                           HorizontalAlignment="Stretch"
                           Height="34"
                           Click="OnCopyUrlClicked" />

                <ui:Button Grid.Column="2"
                           Content="Tải ảnh QR (.png)"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Height="34"
                           Click="OnSavePngClicked" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="#34D399"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
